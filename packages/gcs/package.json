{
  "name": "@fluxmedia/gcs",
  "version": "2.0.3",
  "description": "Google Cloud Storage provider for FluxMedia - unified media upload library",
  "keywords": [
    "fluxmedia",
    "gcs",
    "google-cloud",
    "storage",
    "cloud",
    "media",
    "upload"
  ],
  "homepage": "https://www.fluxmedia.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/codewithveek/fluxmedia.git",
    "directory": "packages/gcs"
  },
  "license": "MIT",
  "author": "FluxMedia Contributors",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@fluxmedia/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.19.4",
    "typescript": "^5.3.3",
    "@google-cloud/storage": "^7.16.0"
  },
  "peerDependencies": {
    "@google-cloud/storage": "^7.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
